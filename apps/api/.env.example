# Copiar a .env y completar.

# Conexión de la app. Local: Postgres de docker-compose.yml (puerto 5434: el 5432 suele estar ocupado).
# Producción (Neon): la URL con pooler ("-pooler" en el host).
DATABASE_URL="postgresql://kaname:kaname@localhost:5434/kaname?schema=public"
# Conexión directa, la usan las migraciones. Local: igual a DATABASE_URL. Neon: la URL sin pooler.
DIRECT_URL="postgresql://kaname:kaname@localhost:5434/kaname?schema=public"

PORT=4000
# Orígenes de la web permitidos por CORS, separados por coma (sin barra final).
WEB_ORIGIN="http://localhost:3000"

# Firma de los access tokens (JWT, HS256). Mínimo 32 caracteres. Generar uno por entorno con:
#   openssl rand -base64 48
# Nunca reutilizar el de desarrollo en producción.
JWT_ACCESS_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres"

# Rate limit de POST /api/auth/login y /api/auth/register. Los dos límites corren a la vez.
# Por IP: intentos en la ventana (segundos).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
# Por email (frena un ataque a una cuenta desde muchas IPs): 10 intentos cada 15 minutos.
LOGIN_EMAIL_RATE_LIMIT=10
LOGIN_EMAIL_RATE_WINDOW_SECONDS=900

# Secreto compartido con la web (el mismo PROXY_SHARED_SECRET en apps/web). Next manda la IP real
# del cliente en un header propio junto con este secreto, y la API solo la usa si coincide; si no,
# usa la IP de la conexión. Nunca se confía en X-Forwarded-For. Obligatorio en producción: sin él,
# el rate limit por IP vería a todos con la IP de Next. Vacío en local. Generar con:
#   openssl rand -base64 48
# PROXY_SHARED_SECRET=

# Registro abierto (POST /api/auth/register). Cualquier valor que no sea "true" lo cierra (403).
REGISTRATION_ENABLED=false

# NODE_ENV=production activa las cookies Secure (solo HTTPS).

# Solo para el seed (pnpm --filter @kaname/api db:seed): contraseña inicial del usuario
# administrador, de al menos 12 caracteres. Sin ella, el usuario queda sin contraseña. No pisa
# una contraseña que ya exista. No hace falta en el servidor.
# SEED_ADMIN_PASSWORD=

# Base de los e2e (pnpm --filter @kaname/api test:e2e). Por defecto kaname_test en el mismo
# Postgres; se crea y se migra sola. El nombre tiene que terminar en _test: los e2e nunca usan
# la base de desarrollo.
# TEST_DATABASE_URL="postgresql://kaname:kaname@localhost:5434/kaname_test"

# Vida del access token en segundos (15 min por defecto). Bajarlo solo para probar la renovación.
# ACCESS_TOKEN_TTL_SECONDS=900

# URL pública de la web: los links de los emails (recuperación de contraseña) apuntan acá.
WEB_URL="http://localhost:3000"

# Emails con Resend (plan gratis). Sin clave (o vacía), fuera de producción los emails se escriben
# en la consola de la API, con los links. En producción es obligatoria: sin ella la API no arranca.
# RESEND_API_KEY="re_..."
# Remitente: con onboarding@resend.dev, Resend solo entrega al email del dueño de la cuenta de
# Resend; para mandar a cualquiera hay que verificar un dominio propio.
MAIL_FROM="Kaname <onboarding@resend.dev>"

# Login con Google (Google Cloud Console → credenciales OAuth de tipo "Aplicación web"). Sin las
# dos, el login con Google queda apagado: la web no muestra el botón y /api/auth/google da 404.
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# URL de vuelta registrada en Google. Por defecto, WEB_URL + /api/auth/google/callback (pasa por
# el proxy de Next, así las cookies de sesión quedan en el dominio de la web).
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
