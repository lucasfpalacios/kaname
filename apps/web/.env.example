# Copiar a .env.local y completar.

# URL de la API (Nest) a la que Next reenvía /api/*. Solo la usa el servidor de Next: el navegador
# siempre llama a /api/* en el mismo origen. Local: la API de `pnpm dev`.
NEST_URL="http://localhost:4000"

# Header con la IP real del cliente que pone el proxy de adelante (en Vercel: x-real-ip). Next la
# reenvía a la API, con PROXY_SHARED_SECRET, y la API la usa para el rate limit.
# Vacío en local: no hay proxy adelante y no se confía en ningún header que mande el cliente.
# CLIENT_IP_HEADER="x-real-ip"
# Secreto compartido con la API (el mismo PROXY_SHARED_SECRET que en apps/api). Sin él, la API
# ignora la IP que manda Next y usa la de la conexión. Vacío en local.
# PROXY_SHARED_SECRET=
