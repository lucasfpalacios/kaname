# Copiar a .env y completar. Las variables se validan al arrancar (src/config/env.ts): si falta una
# obligatoria o tiene un valor inválido, la API no levanta y dice cuál.

# ─── Entorno ────────────────────────────────────────────────────────────────────────────────
# Obligatorio: development, production o test. "production" activa las cookies Secure (solo HTTPS)
# y exige RESEND_API_KEY y PROXY_SHARED_SECRET.
NODE_ENV=development
# Puerto de la API. Por defecto 4000.
PORT=4000

# ─── Base de datos ──────────────────────────────────────────────────────────────────────────
# Obligatoria. Conexión de la app. Local: Postgres de docker-compose.yml (puerto 5434: el 5432 suele
# estar ocupado). Producción (Neon): la URL con pooler ("-pooler" en el host).
DATABASE_URL="postgresql://kaname:kaname@localhost:5434/kaname?schema=public"
# Conexión directa, la usan las migraciones (prisma.config.ts). Local: igual a DATABASE_URL. Neon: la
# URL sin pooler. Si falta, se usa DATABASE_URL.
DIRECT_URL="postgresql://kaname:kaname@localhost:5434/kaname?schema=public"
# Base de los e2e (pnpm --filter @kaname/api test:e2e). Por defecto kaname_test en el mismo
# Postgres; se crea y se migra sola. El nombre tiene que terminar en _test: los e2e nunca usan la
# base de desarrollo.
# TEST_DATABASE_URL="postgresql://kaname:kaname@localhost:5434/kaname_test"

# ─── Web ────────────────────────────────────────────────────────────────────────────────────
# Obligatorio. Orígenes de la web, separados por coma y sin barra final: CORS y la defensa contra
# CSRF (los POST con otro Origin se rechazan).
WEB_ORIGIN="http://localhost:3000"
# URL pública de la web: los links de los emails (recuperación de contraseña) apuntan acá. Por
# defecto http://localhost:3000.
WEB_URL="http://localhost:3000"
# Secreto compartido con la web (el mismo PROXY_SHARED_SECRET en apps/web). Next manda la IP real
# del cliente en un header propio junto con este secreto, y la API solo la usa si coincide; si no,
# usa la IP de la conexión. Nunca se confía en X-Forwarded-For. Obligatorio en producción: sin él,
# el rate limit por IP vería a todos con la IP de Next. Mínimo 32 caracteres; vacío en local.
# Generar con: openssl rand -base64 48
PROXY_SHARED_SECRET=

# ─── Sesiones ───────────────────────────────────────────────────────────────────────────────
# Obligatorio. Firma de los access tokens (JWT, HS256). Mínimo 32 caracteres. Uno por entorno,
# nunca el de desarrollo en producción. Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres"
# Vida del access token en segundos. Por defecto 900 (15 minutos); bajarlo solo para probar la
# renovación.
# ACCESS_TOKEN_TTL_SECONDS=900
# Registro abierto (POST /api/auth/register y cuentas nuevas con Google). Cualquier valor que no sea
# "true" lo cierra.
REGISTRATION_ENABLED=false

# ─── Rate limit ─────────────────────────────────────────────────────────────────────────────
# Login, registro, forgot-password y reset-password. Los dos límites corren a la vez.
# Por IP: intentos en la ventana (segundos). Por defecto 5 por minuto.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
# Por email (frena un ataque a una cuenta desde muchas IPs). Por defecto 10 cada 15 minutos.
# forgot-password tiene su propio límite por email: 3 por hora.
LOGIN_EMAIL_RATE_LIMIT=10
LOGIN_EMAIL_RATE_WINDOW_SECONDS=900

# ─── Emails (Resend) ────────────────────────────────────────────────────────────────────────
# Clave de Resend (plan gratis). Sin clave (o vacía), fuera de producción los emails no salen y la
# consola muestra solo destinatario y asunto. En producción es obligatoria.
RESEND_API_KEY=
# Remitente. Con onboarding@resend.dev, Resend solo entrega al email del dueño de la cuenta de
# Resend; para mandar a cualquiera hay que verificar un dominio propio.
MAIL_FROM="Kaname <onboarding@resend.dev>"
# Solo en desarrollo y sin Resend: escribe el email entero en la consola, con el link de
# recuperación. Cualquier valor que no sea "true" lo apaga. En producción la API no arranca con él.
DEV_LOG_RESET_LINKS=true

# ─── Login con Google ───────────────────────────────────────────────────────────────────────
# Credenciales OAuth de tipo "Aplicación web" (Google Cloud Console). Sin las dos, el login con
# Google queda apagado: la web no muestra el botón y /api/auth/google da 404.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de vuelta registrada en Google. Por defecto, WEB_URL + /api/auth/google/callback (pasa por el
# proxy de Next, así las cookies de sesión quedan en el dominio de la web).
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ─── Seed ───────────────────────────────────────────────────────────────────────────────────
# Solo para pnpm --filter @kaname/api db:seed: contraseña inicial del usuario administrador, de al
# menos 12 caracteres. Sin ella, el usuario queda sin contraseña. No pisa una contraseña que ya
# exista. No hace falta en el servidor.
# SEED_ADMIN_PASSWORD=
